{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.magicterra.stagewright.fabric.StageWrightFabric"
    ],
    "client": [
      "net.magicterra.stagewright.fabric.StageWrightFabricClient"
    ]
  },
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21"
  },
  "suggests": {
    "worlddriver": "${worlddriver_version_range}"
  },
  "breaks": {
    "worlddriver": ${worlddriver_breaks}
  }
}
