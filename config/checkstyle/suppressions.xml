<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
          "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
          "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Mixin members carry a modid$ prefix by convention, so no naming check applies under a mixin package. -->
  <suppress checks="Name$" files="[\\/]mixin[\\/]"/>
</suppressions>
